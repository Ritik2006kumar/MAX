<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080508"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="Back"
                    android:padding="13dp"
                    android:src="@drawable/ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Settings"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Make VoxPilot yours"
                        android:textColor="#9A9AA6"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ PROFILE ============ -->
            <TextView style="@style/SettingsSection" android:text="PROFILE" />

            <LinearLayout style="@style/SettingsCard">

                <TextView style="@style/SettingsLabel" android:text="Your name" />
                <EditText
                    android:id="@+id/userNameInput"
                    style="@style/SettingsField"
                    android:hint="What should VoxPilot call you?"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_marginTop="16dp"
                    android:text="Assistant name" />
                <EditText
                    android:id="@+id/assistantNameInput"
                    style="@style/SettingsField"
                    android:hint="What do you want to call your assistant?"
                    android:inputType="textPersonName|textCapWords" />

                <LinearLayout
                    android:id="@+id/rowPersonality"
                    style="@style/SettingsRow"
                    android:layout_marginTop="12dp">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Assistant personality" />
                        <TextView
                            android:id="@+id/personalityValue"
                            style="@style/SettingsRowSub"
                            android:text="Girlfriend (Sweet &amp; Naughty)" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ AI & VOICE ============ -->
            <TextView style="@style/SettingsSection" android:text="AI &amp; VOICE" />

            <LinearLayout style="@style/SettingsCard">

                <TextView style="@style/SettingsLabel" android:text="Gemini API key" />
                <EditText
                    android:id="@+id/apiKeyInput"
                    style="@style/SettingsField"
                    android:hint="Paste your Gemini API key"
                    android:inputType="textPassword" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Stored only on this phone. Needed for live voice."
                    android:textColor="#7C7C88"
                    android:textSize="12sp" />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowVoiceModel"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Voice model" />
                        <TextView
                            android:id="@+id/voiceModelValue"
                            style="@style/SettingsRowSub"
                            android:text="gemini-3.8-live" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowVoiceName"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="VoxPilot's voice" />
                        <TextView
                            android:id="@+id/voiceNameValue"
                            style="@style/SettingsRowSub"
                            android:text="Aoede" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Voice volume" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/volumeSeek"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progressTint="#FF2D55"
                        android:thumbTint="#FF2D55" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Microphone Mute" />
                        <TextView style="@style/SettingsRowSub" android:text="Mute microphone input by default" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/micMuteSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ CONTROL & PERMISSIONS ============ -->
            <TextView style="@style/SettingsSection" android:text="PHONE CONTROL" />

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/appIconStudioCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="App Icon Studio &amp; Themes" />
                        <TextView style="@style/SettingsRowSub" android:text="Customize neon, gold and cyberpunk app icon styles" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/installedAppsCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="All Installed Apps Drawer" />
                        <TextView style="@style/SettingsRowSub" android:text="View, search and launch any app on your phone" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/setDefaultHomeBtnCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Set as Default Home Launcher" />
                        <TextView style="@style/SettingsRowSub" android:text="Use Max as your primary phone home screen &amp; theme" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/accessibilityCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Accessibility service" />
                        <TextView style="@style/SettingsRowSub" android:text="Lets VoxPilot see the screen and tap for you" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/accessibilityStatus"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/permissionsCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="App permissions" />
                        <TextView style="@style/SettingsRowSub" android:text="Mic, contacts, calls, Bluetooth..." />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/permissionsStatusText"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <Button
                    android:id="@+id/grantPermissionsBtn"
                    style="@style/SettingsGhostButton"
                    android:text="Grant missing permissions" />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowOverlay"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Display over other apps" />
                        <TextView style="@style/SettingsRowSub" android:text="Open apps and alarms from the background" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/overlayStatus"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowWriteSettings"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Modify system settings" />
                        <TextView style="@style/SettingsRowSub" android:text="Brightness and auto-rotate" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/writeStatus"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowDnd"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Do Not Disturb access" />
                        <TextView style="@style/SettingsRowSub" android:text="Silent mode and DND on voice command" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/dndStatus"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowBattery"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Run in background" />
                        <TextView style="@style/SettingsRowSub" android:text="Keeps VoxPilot listening when the screen is off" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/batteryStatus"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowTouchGuard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Touch Guard (Anti-Theft)" />
                        <TextView style="@style/SettingsRowSub" android:text="Loud alarm siren if anyone touches your phone" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowMotionGuard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Motion Guard (Pocket Anti-Theft)" />
                        <TextView style="@style/SettingsRowSub" android:text="Loud alarm siren if anyone moves or lifts your phone" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/deviceAdminCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Device admin" />
                        <TextView style="@style/SettingsRowSub" android:text="Lock the screen on command" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/adminStatusText"
                        style="@style/SettingsStatus" />
                </LinearLayout>

                <Button
                    android:id="@+id/setDefaultAssistantBtn"
                    style="@style/SettingsGhostButton"
                    android:text="Set VoxPilot as default assistant" />
            </LinearLayout>

            <!-- ============ CALLS ============ -->
            <TextView style="@style/SettingsSection" android:text="CALL ASSISTANT" />

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout style="@style/SettingsRow" android:id="@+id/callAnnounceCard">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Announce callers" />
                        <TextView
                            android:id="@+id/callAnnounceStatusText"
                            style="@style/SettingsRowSub"
                            android:text="VoxPilot tells you who is calling" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/callAnnounceSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Read Incoming Messages Aloud" />
                        <TextView style="@style/SettingsRowSub" android:text="Speak out loud when new WhatsApp or SMS arrive" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/messageAnnounceSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Live mode" />
                        <TextView style="@style/SettingsRowSub" android:text="Talk to VoxPilot during calls" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/liveModeSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Driving Mode (Auto-Reply)" />
                        <TextView style="@style/SettingsRowSub" android:text="Auto-reject calls and reply while driving" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/drivingModeSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Sleep Mode (Auto-Reply)" />
                        <TextView style="@style/SettingsRowSub" android:text="Auto-reject calls and reply while sleeping" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sleepModeSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Stealth / Spy Listener Mode" />
                        <TextView style="@style/SettingsRowSub" android:text="Listen silently to ambient conversations and summarize" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/stealthModeSwitch"
                        style="@style/SettingsSwitch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <TextView style="@style/SettingsLabel" android:text="Prime contact" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <EditText
                            android:id="@+id/primeNameInput"
                            style="@style/SettingsField"
                            android:hint="Name"
                            android:inputType="textPersonName|textCapWords" />
                        <EditText
                            android:id="@+id/primeNumberInput"
                            style="@style/SettingsField"
                            android:layout_marginTop="8dp"
                            android:hint="Phone number"
                            android:inputType="phone" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/pickContactBtn"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_icon_btn"
                        android:contentDescription="Pick contact"
                        android:padding="14dp"
                        android:src="@drawable/ic_contact_list" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <TextView style="@style/SettingsLabel" android:text="Call voice" />
                <RadioGroup
                    android:id="@+id/voiceTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioSystem"
                        style="@style/SettingsChip"
                        android:layout_marginEnd="8dp"
                        android:text="Phone voice" />
                    <RadioButton
                        android:id="@+id/radioEleven"
                        style="@style/SettingsChip"
                        android:text="ElevenLabs" />
                </RadioGroup>

                <EditText
                    android:id="@+id/ttsApiKeyInput"
                    style="@style/SettingsField"
                    android:layout_marginTop="10dp"
                    android:hint="ElevenLabs API key (optional)"
                    android:inputType="textPassword" />

                <TextView style="@style/SettingsLabel" android:text="Voice Gender" android:layout_marginTop="12dp" />
                <RadioGroup
                    android:id="@+id/voiceGenderGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioFemale"
                        style="@style/SettingsChip"
                        android:layout_marginEnd="8dp"
                        android:text="Female 👩"
                        android:checked="true" />
                    <RadioButton
                        android:id="@+id/radioMale"
                        style="@style/SettingsChip"
                        android:layout_marginEnd="8dp"
                        android:text="Male 👨" />
                    <RadioButton
                        android:id="@+id/radioJarvis"
                        style="@style/SettingsChip"
                        android:text="Jarvis 🤖" />
                </RadioGroup>

                <EditText
                    android:id="@+id/voiceIdInput"
                    style="@style/SettingsField"
                    android:layout_marginTop="10dp"
                    android:hint="Custom ElevenLabs Voice ID (optional)"
                    android:inputType="text" />
            </LinearLayout>

            <!-- ============ SECURITY ============ -->
            <TextView style="@style/SettingsSection" android:text="SECURITY &amp; PRIVACY" />

            <LinearLayout style="@style/SettingsCard">
                <LinearLayout
                    android:id="@+id/securitySettingsCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="App lock &amp; biometrics" />
                        <TextView
                            android:id="@+id/securityStatusText"
                            style="@style/SettingsRowSub"
                            android:text="PIN, pattern, fingerprint, voice passphrase" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/clearMemoryCard"
                    style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsRowText">
                        <TextView style="@style/SettingsRowTitle" android:text="Clear Conversation Memory" />
                        <TextView style="@style/SettingsRowSub" android:text="Delete all stored chat history and local memories" />
                    </LinearLayout>
                    <ImageView style="@style/SettingsChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ ABOUT ============ -->
            <TextView style="@style/SettingsSection" android:text="ABOUT DEVELOPER" />

            <LinearLayout
                style="@style/SettingsCard"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/developerAvatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:src="@drawable/developer_profile"
                    android:scaleType="centerCrop"
                    android:contentDescription="Developer Photo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Ritik Kumar"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lead Android Developer &amp; AI Engineer"
                    android:textColor="#FF2D55"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Creator of Max AI Assistant — Advanced Voice AI, Security Guards &amp; Automation Tools."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Floating save bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_save_bar"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_send_btn"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="Save settings"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </FrameLayout>
</FrameLayout>
