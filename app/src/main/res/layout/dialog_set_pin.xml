<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1E1E1E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select PIN Length:"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/pinLengthGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <RadioButton android:id="@+id/radio4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" android:checked="true" android:layout_marginEnd="16dp"/>
        <RadioButton android:id="@+id/radio5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" android:layout_marginEnd="16dp"/>
        <RadioButton android:id="@+id/radio6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#FFFFFF"/>
    </RadioGroup>

    <EditText
        android:id="@+id/newPinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New PIN"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/confirmPinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm PIN"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/pinErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF3B30"
        android:visibility="gone"
        android:text="PINs do not match"/>

</LinearLayout>
